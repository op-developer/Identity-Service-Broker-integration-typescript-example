{
  "name": "demo-service-provider",
  "version": "1.0.0",
  "main": "index.js",
  "repository": {},
  "license": "MIT",
  "scripts": {
    "lint": "eslint \"src/**/*.ts\"",
    "start": "node ./dist/index.js",
    "build": "npm-run-all build:*",
    "build:ts": "tsc",
    "build:templates": "cp -r src/templates dist/templates",
    "build:locales": "cp -r src/locales dist/locales",
    "build:scss": "sass src/scss/style.scss dist/public/style.css",
    "develop": "npm-run-all --parallel develop:*",
    "develop:ts": "nodemon --ext ts,hbs --watch src --exec ts-node -- ./src/index.ts",
    "develop:scss": "npm run build:scss && npm run build:scss -- --watch",
    "develop:locales": "nodemon --ext json --watch src/locales --exec npm run -- build:locales"
  },
  "dependencies": {
    "@hapi/hapi": "^21.4.10",
    "@hapi/inert": "^7.1.2",
    "@hapi/vision": "7.0.3",
    "@hapi/yar": "11.0.3",
    "@types/i18next-node-fs-backend": "2.1.5",
    "@types/node": "26.6.4",
    "5w-logger": "1.0.4",
    "crypto-random-string": "^3.3.1",
    "handlebars": "^4.7.10",
    "i18next": "^26.4.2",
    "i18next-fs-backend": "2.6.8",
    "joi": "18.2.9",
    "jose": "^6.2.12",
    "nodemon": "3.1.14",
    "npm-run-all": "^4.1.5",
    "sass": "^1.105.1",
    "ts-node": "10.9.2",
    "typescript": "^5.9.3",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint-plugin-functional": "^10.0.1",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.71.1"
  },
  "overrides": {
    "nodemon": {
      "chokidar": "^4.0.3"
    },
    "deepmerge-ts": "^8.0.2"
  }
}
